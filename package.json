{
  "name": "dsh-cherry-bridge",
  "version": "0.1.3",
  "type": "module",
  "private": false,
  "packageManager": "npm@10.9.9",
  "description": "DeepSeek Harness plugin bridging to Cherry Studio desktop instances over remote transport",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAXEM1997/dsh-cherry-bridge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cherry-studio",
    "remote-access"
  ],
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "dist",
    "src",
    "ui",
    "locale",
    "docs/e2e-checklist.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "static"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "build:client": "vite build --mode client --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run build:client && npm pack --dry-run"
  },
  "dependencies": {
    "@cherrystudio/remote-protocol": "0.5.0",
    "@cherrystudio/remote-transport": "0.2.1",
    "ws": "8.22.0",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@libp2p/interface": "3.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
