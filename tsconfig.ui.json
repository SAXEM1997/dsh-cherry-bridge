{
  // The UI project: the settings page (`ui/**`) and the three tests that must
  // run in a UI environment — `tests/unit/ui.test.ts` and
  // `tests/unit/uiScopePanel.test.ts` (both jsdom + testing-library; the second
  // covers the 「启用范围」 settings section) plus
  // `tests/integration/clientBundle.test.ts` (it loads the built bundle in a
  // browser-shaped VM). Its counterpart is `tsconfig.json`; the split is
  // load-bearing because this project adds the DOM libs and `jsx: react-jsx`,
  // and the server project deliberately excludes exactly these files so each is
  // checked by exactly one project (see `tests/unit/projectCoverage.test.ts`).
  //
  // `ui/src/dev.tsx` is intentionally INCLUDED, not excluded: it typechecks
  // today, and it is the only consumer of the dev-only `ui/index.html` harness
  // — excluding it would let the harness rot silently against the components it
  // renders (the dev page is not covered by the client bundle build).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `vitest/globals` is deliberately NOT listed. Vitest's `globals` is off
    // (the default, and not enabled in `vitest.config.ts`), so the runner
    // injects no `describe`/`it`/`expect` at runtime. Declaring the types
    // anyway would make a bare `describe(...)` TYPECHECK cleanly and then crash
    // the moment the suite ran — a green compile in front of a dead test. The
    // tests import their helpers from 'vitest' explicitly, which is what the
    // runner actually provides.
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "ui",
    "tests/unit/ui.test.ts",
    "tests/unit/uiScopePanel.test.ts",
    "tests/integration/clientBundle.test.ts"
  ]
}
